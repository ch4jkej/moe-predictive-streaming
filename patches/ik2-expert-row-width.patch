+// Each lane consumes one eight-weight code at a time and applies its scale after the dot.
+template <int Q>
+__device__ __forceinline__ float iq_group_dot(const uint8_t* b, int group, float4 x0, float4 x1) {
+    const auto* b16 = reinterpret_cast<const uint16_t*>(b);
+    const float d = h2f(__ldg(b16));
+    if constexpr (Q == kIQ4_NL) {
+        const auto* q = b16 + 1 + 2 * group;
+        const uint32_t packed = __ldg(q) | ((uint32_t) __ldg(q + 1) << 16);
+        return d * (dot_u32_f4(iq4nl_lut4(packed, false), x0) + dot_u32_f4(iq4nl_lut4(packed, true), x1));
+    } else {
+        const int sub = group >> 2, lane_in_sub = group & 3;
+        uint32_t grid0, grid1, signs;
+        int scale;
+        if constexpr (Q == kIQ3_XXS) {
+            const auto* s = b16 + 33 + 2 * sub;
+            const uint32_t aux = __ldg(s) | ((uint32_t) __ldg(s + 1) << 16);
+            const uint32_t code = __ldg(b16 + 1 + group);
+            grid0 = __ldg(d_iq3xxs_grid + (code & 255u));
+            grid1 = __ldg(d_iq3xxs_grid + (code >> 8));
+            signs = iq_signs8((aux >> (7 * lane_in_sub)) & 127u);
+            scale = aux >> 28;
+        } else {
+            uint64_t grid;
+            if constexpr (Q == kIQ2_XXS) {
+                const auto* q = b16 + 1 + 4 * sub;
+                const uint32_t aux = __ldg(q + 2) | ((uint32_t) __ldg(q + 3) << 16);
+                grid = __ldg(ik2_ggml_device::iq2xxs_grid + __ldg(b + 2 + 8 * sub + lane_in_sub));
+                signs = iq_signs8((aux >> (7 * lane_in_sub)) & 127u);
+                scale = aux >> 28;
+            } else if constexpr (Q == kIQ2_XS) {
+                const uint32_t code = __ldg(b16 + 1 + group);
+                grid = __ldg(ik2_ggml_device::iq2xs_grid + (code & 511u));
+                signs = iq_signs8(code >> 9);
+                scale = (__ldg(b + 66 + sub) >> (4 * (lane_in_sub >> 1))) & 15;
+            } else {
+                static_assert(Q == kIQ2_S);
+                const int code = __ldg(b + 2 + group) | ((__ldg(b + 66 + sub) << (8 - 2 * lane_in_sub)) & 0x300);
+                grid = __ldg(ik2_ggml_device::iq2s_grid + code);
+                signs = __ldg(b + 34 + group);
+                scale = (__ldg(b + 74 + sub) >> (4 * (lane_in_sub >> 1))) & 15;
+            }
+            grid0 = (uint32_t) grid;
+            grid1 = (uint32_t) (grid >> 32);
+        }
+        constexpr float scale_step = Q == kIQ3_XXS ? 0.5f : 0.25f;
+        return d * ((0.5f + (float) scale) * scale_step) *
+               (sdot4_u8(grid0, signs, x0) + sdot4_u8(grid1, signs >> 4, x1));
+    }
+}
