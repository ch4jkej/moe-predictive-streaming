+template <int Q, bool Pair>
+__device__ __forceinline__ void iq_row_dot(const uint8_t* w0, const uint8_t* w1, const float* xs, int K,
+                                          float& y0, float& y1) {
+    constexpr int groups_per_block = Q == kIQ4_NL ? 4 : 32;
+    constexpr int bytes = Q == kIQ4_NL ? 18 : Q == kIQ2_XXS ? 66 : Q == kIQ2_XS ? 74 : Q == kIQ2_S ? 82 : 98;
+    const int lane = threadIdx.x & 31;
+    float a0 = 0.0f, a1 = 0.0f;
+    if (((reinterpret_cast<uintptr_t>(w0) | reinterpret_cast<uintptr_t>(w1)) & 1) == 0) {
+        for (int g = lane; g < K / 8; g += 32) {
+            const size_t offset = (size_t) (g / groups_per_block) * bytes;
+            const int sub = g % groups_per_block;
+            const float* x = xs + (g >> 2) * 36 + (g & 3) * (Q == kIQ4_NL ? 4 : 8);
+            const float4 x0 = *reinterpret_cast<const float4*>(x);
+            const float4 x1 = *reinterpret_cast<const float4*>(x + (Q == kIQ4_NL ? 16 : 4));
+            a0 += iq_group_dot<Q>(w0 + offset, sub, x0, x1);
+            if constexpr (Pair) a1 += iq_group_dot<Q>(w1 + offset, sub, x0, x1);
+        }
+    } else {
+        for (int i = lane; i < K; i += 32) {
+            const float x = xs[xp(i)];
+            a0 += decode_value(Q, w0, i) * x;
+            if constexpr (Pair) a1 += decode_value(Q, w1, i) * x;
+        }
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        a0 += __shfl_xor_sync(0xffffffffu, a0, o);
+        if constexpr (Pair) a1 += __shfl_xor_sync(0xffffffffu, a1, o);
+    }
+    y0 = a0;
+    if constexpr (Pair) y1 = a1;
+}
