+__host__ __device__ inline float decode_iq2(int type, const uint8_t* blocks, size_t v) {
+#ifdef __CUDA_ARCH__
+    namespace codebooks = ik2_ggml_device;
+#else
+    namespace codebooks = ik2_ggml_host;
+#endif
+    const int i = (int) (v % 256), ib = i / 32, group = (i % 32) / 8, j = i % 8;
+    const int block_bytes = type == kIQ2_XXS ? 66 : type == kIQ2_XS ? 74 : 82;
+    const uint8_t* b = blocks + (v / 256) * block_bytes;
+    const float d = half_bits_to_float((uint16_t) (b[0] | (b[1] << 8)));
+    uint64_t grid;
+    uint32_t signs;
+    int scale;
+    if (type == kIQ2_XXS) {
+        const uint8_t* q = b + 2 + 8 * ib;
+        const uint32_t aux = (uint32_t) q[4] | ((uint32_t) q[5] << 8) |
+                             ((uint32_t) q[6] << 16) | ((uint32_t) q[7] << 24);
+        grid = codebooks::iq2xxs_grid[q[group]];
+        signs = iq_signs8((aux >> (7 * group)) & 127u);
+        scale = aux >> 28;
+    } else if (type == kIQ2_XS) {
+        const uint8_t* q = b + 2 + 8 * ib + 2 * group;
+        const uint32_t code = q[0] | ((uint32_t) q[1] << 8);
+        grid = codebooks::iq2xs_grid[code & 511u];
+        signs = iq_signs8(code >> 9);
+        scale = (b[66 + ib] >> (4 * (group / 2))) & 15;
+    } else {
+        const int index = 4 * ib + group;
+        const int code = b[2 + index] | ((b[66 + ib] << (8 - 2 * group)) & 0x300);
+        grid = codebooks::iq2s_grid[code];
+        signs = b[34 + index];
+        scale = (b[74 + ib] >> (4 * (group / 2))) & 15;
+    }
+    const float db = d * (0.5f + (float) scale) * 0.25f;
+    const float w = (float) ((grid >> (8 * j)) & 255u);
+    return db * w * ((signs >> j) & 1u ? -1.0f : 1.0f);
+}
